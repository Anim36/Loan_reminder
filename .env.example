# Copy this file to `.env.local` and fill in real values.
# Never commit a populated `.env.local` or any file that contains a
# real secret.

# ─── Database ────────────────────────────────────────────────────────
# PostgreSQL connection string used by Prisma. Local dev example:
#
#   postgresql://loan:loan@localhost:5432/loan_reminder?schema=public
#
# In production, point at a managed Postgres (Neon, Supabase, RDS…)
# and use a connection pooler (pgBouncer / Prisma Accelerate) on the
# "pooled" port. The `?schema=public` suffix is fine to keep.
DATABASE_URL=postgresql://loan:loan@localhost:5432/loan_reminder?schema=public

# Direct (non-pooled) connection used by `prisma migrate deploy` and
# `prisma db seed`. Same connection string is fine for a single host.
DIRECT_URL=postgresql://loan:loan@localhost:5432/loan_reminder?schema=public

# ─── Auth.js (NextAuth v5) ──────────────────────────────────────────
# Secret used by Auth.js to sign session/JWT tokens. Generate with
# `openssl rand -base64 32`. Never commit this value.
AUTH_SECRET=replace-me-with-a-long-random-string

# Canonical site URL — no trailing slash. Used by Auth.js for
# callback URL construction, password-reset email links, and
# `generateMetadata` fallbacks.
AUTH_URL=http://localhost:3000

# Optional — the public origin. Falls back to AUTH_URL when unset.
APP_URL=http://localhost:3000

# Google OAuth — leave BOTH empty to disable "Continue with Google".
# When either is empty the button is hidden and the provider is not
# registered. The app starts and works fine with only email/password.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ─── Email ───────────────────────────────────────────────────────────
# Resend is the only email provider the app currently supports. The
# API key lives server-side only. When `RESEND_API_KEY` is empty the
# reset link is written to the server log (development only — never
# log tokens in production).
RESEND_API_KEY=
# Sender address must be a verified sender on the Resend account.
EMAIL_FROM=Loan Reminder <noreply@loan-reminder.app>

# ─── SMS ─────────────────────────────────────────────────────────────
# Pluggable provider. Set to "mock" while developing to skip network
# calls entirely. The `sendSms` helper in `src/server/messaging/sms.ts`
# reads these values.
SMS_PROVIDER=mock
SMS_API_URL=
SMS_API_KEY=
# Sender id registered with the carrier. Bangladesh carriers require
# an explicit sender id; default to "LoanReminder" while developing.
SMS_SENDER_ID=LoanReminder

# ─── Cron / background jobs ─────────────────────────────────────────
# Shared secret the cron worker sends in the `Authorization` header
# when it calls the `/api/cron/*` endpoints. Same value goes in the
# cron-job configuration (Vercel Cron / GitHub Actions / etc).
CRON_SECRET=replace-me-with-a-long-random-string
