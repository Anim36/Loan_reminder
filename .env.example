# Copy this file to `.env.local` and fill in real values.
#
# Leaving `NEXT_PUBLIC_API_URL` empty keeps the app in "prototype mode"
# — every service falls back to the localStorage-backed store. Set it
# to your backend's base URL (no trailing slash) to switch the app over
# to the live API.

# Base URL of the Loan Reminder backend.
# Example: https://api.loan-reminder.app
NEXT_PUBLIC_API_URL=

# Optional: default request timeout in milliseconds (defaults to 30000).
# NEXT_PUBLIC_API_TIMEOUT_MS=30000